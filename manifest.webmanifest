{
 "name": "Willi's Rezepte Sammlung",
 "short_name": "Rezepte",
 "description": "Wochenplan, Rezepte und Einkaufsliste",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#F2F5F1",
 "theme_color": "#2E6B4F",
 "lang": "de",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "shot",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 }
}